# ─── AliExpress Affiliate API ────────────────────────────────────────────────
ALIEXPRESS_APP_KEY=your_app_key_here
ALIEXPRESS_APP_SECRET=your_app_secret_here
ALIEXPRESS_TRACKING_ID=your_tracking_id_here

# ─── Amazon Product Advertising API (opcional) ───────────────────────────────
AMAZON_ACCESS_KEY=your_access_key_here
AMAZON_SECRET_KEY=your_secret_key_here
AMAZON_PARTNER_TAG=your_partner_tag_here
AMAZON_REGION=ES

# ─── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHANNEL_ID=@your_channel_or_-100xxxxxxxxx

# ─── Instagram Graph API ──────────────────────────────────────────────────────
INSTAGRAM_ACCESS_TOKEN=your_long_lived_token_here
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_ig_business_id_here

# ─── TikTok API ───────────────────────────────────────────────────────────────
TIKTOK_CLIENT_KEY=your_client_key_here
TIKTOK_CLIENT_SECRET=your_client_secret_here
TIKTOK_ACCESS_TOKEN=your_access_token_here

# ─── Anthropic Claude (geração de conteúdo) ───────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Configuração Geral ───────────────────────────────────────────────────────
LOG_LEVEL=INFO
DB_PATH=affiliate_bot.db
IMAGES_DIR=generated_images

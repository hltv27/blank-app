{
  "manifest_version": 3,
  "name": "RAM Saver — Suspensor de Separadores",
  "version": "1.0.0",
  "description": "Reduz o consumo de RAM do Chrome suspendendo automaticamente separadores inactivos. Sem permissões de acesso ao conteúdo das páginas.",
  "permissions": ["tabs", "storage", "alarms"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "RAM Saver"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "suspend-current-tab": {
      "suggested_key": { "default": "Ctrl+Shift+U", "mac": "Command+Shift+U" },
      "description": "Suspender o separador actual"
    },
    "suspend-all-inactive": {
      "suggested_key": { "default": "Ctrl+Shift+I", "mac": "Command+Shift+I" },
      "description": "Suspender todos os separadores inactivos"
    }
  },
  "minimum_chrome_version": "109"
}

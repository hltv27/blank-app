# REBORNFENIX — Variáveis de ambiente para deploy
# Copia este ficheiro para .env e preenche os valores REAIS
# NUNCA commites o ficheiro .env para o git!

# Chave privada da tua carteira Solana em formato base58
# Para exportar da Phantom: Settings → Security & Privacy → Export Private Key
SOLANA_PRIVATE_KEY=your_base58_private_key_here

# Rede Solana: "devnet" para testes, "mainnet-beta" para lançamento real
SOLANA_NETWORK=devnet

# Preenchido automaticamente pelo script deploy_collection.js
COLLECTION_ADDRESS=

# Preenchido automaticamente pelo script create_merkle_tree.js
TREE_ADDRESS=
